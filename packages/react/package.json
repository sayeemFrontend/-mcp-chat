{
  "name": "mcp-chat-react",
  "version": "0.1.0",
  "description": "React component that embeds the MCP Chat assistant (iframe + postMessage).",
  "keywords": [
    "react",
    "chat",
    "widget",
    "assistant",
    "mcp"
  ],
  "author": "Sayeem",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sayeemFrontend/mcp.git",
    "directory": "chat-widget/packages/react"
  },
  "homepage": "https://github.com/sayeemFrontend/mcp/tree/main/chat-widget/packages/react#readme",
  "bugs": "https://github.com/sayeemFrontend/mcp/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "pack": "npm run build && npm pack"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.1"
  }
}
