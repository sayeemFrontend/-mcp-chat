# URL of the LLM server (FastAPI)
VITE_CHAT_API_URL=http://localhost:8000
# URL of the admin console (admin-frontend); without a key the chat links to its /signup page to get one
VITE_ADMIN_URL=http://localhost:5175
# Widget key of the standalone chat app (admin console -> Keys), pk_...; empty = the public assistant (no key)
VITE_WIDGET_KEY=pk_dev_firm1
